# Copy this file to .env and fill in your own values, or export these as
# real environment variables / GitHub Actions secrets. Never commit a
# file named .env -- it's already in .gitignore.

# Only needed if you want the email digest. For Gmail, use an App
# Password (https://myaccount.google.com/apppasswords), not your normal
# password -- your account needs 2-Step Verification on for that page to
# appear.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_TO=bhargavi131313@gmail.com
EMAIL_FROM=your.address@gmail.com
